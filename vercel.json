{
  "version": 2,
  "rewrites": [
    {
      "source": "/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...slug]"
    }
  ]
}
